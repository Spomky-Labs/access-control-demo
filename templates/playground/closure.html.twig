{% extends 'base.html.twig' %}

{% block title %}ClosureVoter{% endblock %}

{% block body %}
    <h1>ClosureVoter (programmatic)</h1>
    <p>
        These decisions were computed by calling <code>AccessControlManager::decide()</code>
        with a <strong>closure</strong> as the attribute — the path a controller uses when a
        rule is too ad-hoc for an attribute.
    </p>
    <table>
        <thead><tr><th>Rule</th><th>Result</th><th>Reason</th></tr></thead>
        <tbody>
            {% for label, result in results %}
                <tr>
                    <td>{{ label }}</td>
                    <td>{% if result.granted %}✅ granted{% else %}⛔ denied{% endif %}</td>
                    <td class="muted">{{ result.reason }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
