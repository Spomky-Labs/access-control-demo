{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
    <h1>Log in</h1>

    {% if error %}
        <div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" style="display:grid; gap:.75rem; max-width:20rem;">
        <label>Username
            <input type="text" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
        </label>
        <label>Password
            <input type="password" name="_password" autocomplete="current-password" required>
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit">Sign in</button>
    </form>

    <p class="muted">Try <code>user</code>, <code>manager</code> or <code>admin</code> (password = username).</p>
{% endblock %}
