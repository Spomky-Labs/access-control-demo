{% set current_route = app.request.attributes.get('_route') %}
{% set current_section = catalogue_section_of(current_route) %}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}AccessControl demo{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🔐</text></svg>">
        <style>
            :root { color-scheme: light dark; }
            body { font-family: system-ui, sans-serif; margin: 0; line-height: 1.5; }
            header { display: flex; align-items: center; gap: 1.5rem; padding: .75rem 1.5rem;
                     border-bottom: 1px solid #8883; flex-wrap: wrap; }
            header nav { display: flex; gap: 1rem; }
            header .spacer { margin-left: auto; }
            header a { text-decoration: none; }
            header nav a.active { font-weight: 600; text-decoration: underline; }
            .subnav { display: flex; gap: 1rem; flex-wrap: wrap; align-items: baseline;
                      padding: .5rem 1.5rem; border-bottom: 1px solid #8883; font-size: .9rem; }
            .subnav a { text-decoration: none; }
            .subnav a.active { font-weight: 600; text-decoration: underline; }
            .subnav .label { opacity: .55; text-transform: uppercase; letter-spacing: .06em;
                             font-size: .7rem; }
            main { max-width: 52rem; margin: 0 auto; padding: 1.5rem; }
            .badge { font-size: .75rem; padding: .1rem .45rem; border-radius: .5rem;
                     background: #8882; white-space: nowrap; }
            .flash { padding: .75rem 1rem; border-radius: .5rem; margin: .5rem 0; }
            .flash-error { background: #e5393533; border: 1px solid #e5393588; }
            .flash-success { background: #43a04733; border: 1px solid #43a04788; }
            table { border-collapse: collapse; width: 100%; }
            th, td { text-align: left; padding: .5rem .75rem; border-bottom: 1px solid #8883; }
            code { background: #8882; padding: .1rem .35rem; border-radius: .35rem; }
            .muted { opacity: .7; }
            .card { border: 1px solid #8883; border-radius: .6rem; padding: 1rem 1.25rem;
                    margin: 1rem 0; }
            .card h3 { margin: 0 0 .25rem; font-size: 1rem; }
            .card + .card { margin-top: .75rem; }
            .needs { font-size: .8rem; }
        </style>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header>
            <strong>🔐 AccessControl</strong>
            {# Generated from App\Service\Catalogue: the order of the demo lives there, not here. #}
            <nav>
                <a href="{{ path('app_home') }}"{{ 'app_home' == current_route ? ' class="active"' : '' }}>Home</a>
                {% for id, section in catalogue_sections() %}
                    <a href="{{ path(section.route) }}"{{ current_section and current_section.id == id ? ' class="active"' : '' }}>{{ section.label }}</a>
                {% endfor %}
            </nav>
            <div class="spacer"></div>
            {% if app.user %}
                <span>Signed in as <strong>{{ app.user.userIdentifier }}</strong></span>
                {% for role in app.token.roleNames %}<span class="badge">{{ role }}</span>{% endfor %}
                <a href="{{ path('app_logout') }}">Log out</a>
            {% else %}
                <span class="muted">Not signed in</span>
                <a href="{{ path('app_login') }}">Log in</a>
            {% endif %}
        </header>

        {# The pages of whichever section this one belongs to, so a page never has to say where it sits. #}
        {% if current_section %}
            <div class="subnav">
                <span class="label">{{ current_section.label }}</span>
                <a href="{{ path(current_section.route) }}"{{ current_section.route == current_route ? ' class="active"' : '' }}>Overview</a>
                {% for entry in current_section.entries %}
                    <a href="{{ path(entry.route, entry.params|default({})) }}"{{ entry.route == current_route ? ' class="active"' : '' }}>{{ entry.title }}</a>
                {% endfor %}
            </div>
        {% endif %}

        <main>
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
